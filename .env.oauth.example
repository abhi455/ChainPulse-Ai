# ChainPulse OAuth / Authentication

CHAINPULSE_OAUTH_ENABLED=false

CHAINPULSE_SESSION_SECRET=replace-with-a-long-random-secret

CHAINPULSE_OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
CHAINPULSE_OAUTH_FRONTEND_URL=http://localhost:8501

# Only needed when allowing first-time OAuth provisioning.
# Otherwise an existing ChainPulse user with the same email
# must already exist.
OAUTH_DEFAULT_ORGANIZATION_ID=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Meta / Facebook Login
META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_API_BASE=https://graph.facebook.com

CHAINPULSE_SECRET_KEY=replace-with-a-long-random-secret
